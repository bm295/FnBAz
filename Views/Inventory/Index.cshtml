@model IReadOnlyList<InventoryItem>

<h2>Inventory Management</h2>
<form asp-action="Create" method="post" class="grid-form">
    @Html.AntiForgeryToken()
    <input name="Ingredient" placeholder="Ingredient" required />
    <input name="Quantity" type="number" min="0" step="0.01" placeholder="Quantity" required />
    <input name="Unit" placeholder="Unit (kg, ltr, pcs)" required />
    <input name="ReorderLevel" type="number" min="0" step="0.01" placeholder="Reorder level" required />
    <button type="submit">Add Item</button>
</form>

<table>
    <thead><tr><th>Ingredient</th><th>Quantity</th><th>Unit</th><th>Reorder Level</th><th>Actions</th></tr></thead>
    <tbody>
    @if (Model.Count == 0)
    {
        <tr><td colspan="5">No inventory items.</td></tr>
    }
    else
    {
        foreach (var item in Model)
        {
            <tr>
                <td>@item.Ingredient</td>
                <td>@item.Quantity</td>
                <td>@item.Unit</td>
                <td>@item.ReorderLevel</td>
                <td>
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    }
    </tbody>
</table>
