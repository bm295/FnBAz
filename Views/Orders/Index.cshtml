@model IReadOnlyList<Order>

<h2>Order Management</h2>
<form asp-action="Create" method="post" class="grid-form">
    @Html.AntiForgeryToken()
    <input name="tableNumber" placeholder="Table number" required />
    <select name="menuItemId" required asp-items="ViewBag.MenuItems">
        <option value="">Select menu item</option>
    </select>
    <input name="quantity" type="number" min="1" value="1" required />
    <button type="submit">Create Order</button>
</form>

<table>
    <thead><tr><th>ID</th><th>Table</th><th>Menu Item</th><th>Qty</th><th>Status</th><th>Created (UTC)</th><th>Update</th></tr></thead>
    <tbody>
    @if (Model.Count == 0)
    {
        <tr><td colspan="7">No orders yet.</td></tr>
    }
    else
    {
        foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.TableNumber</td>
                <td>@order.MenuItem?.Name</td>
                <td>@order.Quantity</td>
                <td>@order.Status</td>
                <td>@order.CreatedAtUtc.ToString("u")</td>
                <td>
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@order.Id" />
                        <select name="status">
                            @foreach (var status in Enum.GetValues<OrderStatus>())
                            {
                                <option value="@status" selected="@(status == order.Status)">@status</option>
                            }
                        </select>
                        <button type="submit">Save</button>
                    </form>
                </td>
            </tr>
        }
    }
    </tbody>
</table>
