@model IReadOnlyList<MenuItem>

<h2>Menu Management</h2>
<form asp-action="Create" method="post" class="grid-form">
    @Html.AntiForgeryToken()
    <input name="Name" placeholder="Item name" required />
    <input name="Category" placeholder="Category" required />
    <input name="Price" type="number" min="0" step="0.01" placeholder="Price" required />
    <label><input type="checkbox" name="IsAvailable" value="true" checked /> Available</label>
    <button type="submit">Add Item</button>
</form>

<table>
    <thead><tr><th>Name</th><th>Category</th><th>Price</th><th>Available</th><th>Actions</th></tr></thead>
    <tbody>
    @if (Model.Count == 0)
    {
        <tr><td colspan="5">No menu items.</td></tr>
    }
    else
    {
        foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Category</td>
                <td>@item.Price.ToString("C")</td>
                <td>@(item.IsAvailable ? "Yes" : "No")</td>
                <td>
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    }
    </tbody>
</table>
